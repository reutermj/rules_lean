load("@rules_lean//lean:defs.bzl", "lean_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Test: Basic lean_binary compilation and execution
#
# Requirement: A minimal Lean program should compile and run successfully.
#
# Approach: Build and run a simple "Hello, World!" program.
#
# Why this matters: This is the most basic sanity check that the toolchain
# and rules are working end-to-end.
lean_binary(
    name = "hello",
    src = "Main.lean",
)

# Test: Exit code propagation from Lean programs
#
# Requirement: When a Lean program exits with a non-zero code, Bazel must
# propagate that exit code to the caller.
#
# Approach: Build and run a program that calls `IO.Process.exit 42`, then
# verify the exit code is 42.
#
# Why this matters: Without proper exit code propagation, build scripts and
# CI systems can't detect when Lean programs fail.
lean_binary(
    name = "exit_test",
    src = "ExitTest.lean",
)

# Test: Module naming with BUILD at workspace root, source in subdirectory
#
# Requirement: When a BUILD file at the workspace root references a source file
# in a subdirectory, the module name must be derived from the workspace-relative
# path, not just the filename.
#
# Approach: Reference subdir/inner/Nested.lean from this BUILD file. The module
# name should be "subdir.inner.Nested", not just "Nested".
#
# Why this matters: Correct module naming is essential for imports. If module
# names don't match the directory structure, cross-module imports will fail.
lean_binary(
    name = "nested_module_test",
    src = "subdir/inner/Nested.lean",
)

# Test: Verify lean_binary produces statically-linked executables
#
# Requirement: Lean binaries should only depend on basic system libraries,
# not on Lean-specific shared libraries or libc++.
#
# Approach: Run ldd on the hello binary and verify no forbidden dependencies.
#
# Why this matters: Static linking ensures binaries are portable and don't
# require users to install Lean runtime libraries.
sh_test(
    name = "verify_static_linking_test",
    srcs = ["verify_static_linking_test.sh"],
    args = ["$(location :hello)"],
    data = [":hello"],
)

# Test: Document binary characteristics for hermetic toolchain verification
#
# Requirement: When a hermetic CC toolchain (toolchains_cc) is registered,
# builds should use its compiler and sysroot, not the system compiler.
#
# Approach: Examine the built binary's characteristics (compiler info, library
# dependencies) to document the build configuration.
#
# Why this matters: Hermetic toolchains ensure reproducible builds across
# different machines regardless of their system libraries.
#
# Note: Full hermetic verification requires inspecting build commands with -s flag.
sh_test(
    name = "verify_hermetic_toolchain_test",
    srcs = ["verify_hermetic_toolchain_test.sh"],
    args = ["$(location :hello)"],
    data = [":hello"],
)
